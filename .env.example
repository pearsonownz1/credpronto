# Names only. Values live in the Vercel project (credpronto). Never commit secrets.

# Public client (browser + server cookie client).
# Auth redirects land on {APP_URL}/auth/callback. Enable Email and Google in the Supabase project.
# Set both mock names to 1 to exercise account and admin UI without Supabase. Tests do this.
CREDPRONTO_MOCK=
NEXT_PUBLIC_CREDPRONTO_MOCK=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=

# Postgres (Supabase integration)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Public site URL used in email links. No trailing slash.
APP_URL=

# Vercel AI Gateway. On Vercel, OIDC is used when this is unset.
# Calls go through the AI SDK (`generateText`) with a provider/model id.
AI_GATEWAY_API_KEY=
# Default: google/gemini-3.8-flash
TRANSLATION_MODEL=

# Resend. If either name is unset, email is logged and skipped.
RESEND_API_KEY=
EMAIL_FROM=

# Stripe Checkout. If STRIPE_SECRET_KEY is unset and CHECKOUT_PLACEHOLDER is not 1,
# POST /api/orders/[token]/checkout returns 503 { "error": "Payments not configured" }.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Browser key for the saved-card form on /dashboard/integrations. Test mode uses pk_test_…
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Set to 1 to mark the payment paid_test without calling Stripe.
CHECKOUT_PLACEHOLDER=

# Set to 1 to offer Diploma evaluation and Course-by-course on the upload form.
# Leave unset so production stays on translation-only uploads.
NEXT_PUBLIC_EVALUATIONS_LIVE=

# Google Ads tag on every page. Defaults to AW-18508202440 when unset.
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Purchase conversion label. NEXT_PUBLIC_GADS_PURCHASE_LABEL wins.
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL is the fallback. When both are unset, no conversion is sent.
NEXT_PUBLIC_GADS_PURCHASE_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
